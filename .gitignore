# ── HM-G additions (2026-05-04) — fat-file prevention ─────────────────────────
# Audit lesson: 1.32 GB of DB backup snapshots landed in commit 463c402 and
# blocked origin push for a week. Never again.

# Database backup snapshots in backups/ — catches trader.db.pre_*, .pre-*, etc.
backups/*.db.*

# DB working sidecars beside backup snapshots
backups/*-shm
backups/*-wal

# Stub DB at repo root (distinct from data/trader.db)
/trader.db

# Deprecated / archive markers (e.g., arena.db.deprecated_20260503_182837)
*.deprecated_*

# FUSE archive directories
.fuse_archive_*/

# Editor crash/merge backups (narrow — does NOT match the existing
# dashboard/app.py.bak.* sprint-backup convention which is intentionally tracked)
*.orig
*.swp

# ── HM-W additions (2026-05-05) — chronic working-tree noise ─────────────────
# Runtime artifacts regenerated by the service. Were tracked previously and
# kept showing as modified each session. Untrack via git rm --cached + ignore.
dashboard/static/morning_briefing.mp3
data/equity_curve.json
data/premarket_gaps.json

# Schwab CSV import archive — local-only audit trail, not source of truth.
data/schwab_csv_archive/

# Schwab inbox — transient personal CSVs dropped by Admiral, never commit (HM-AT-β 2026-05-07).
inbox/*
!inbox/.gitkeep

# Top-level XO_BACKLOG snapshots (use git history; live file is source of truth).
docs/*.bak
docs/*.bak.*

# HM-I-β-Item5: daily reconciliation reports — generated daily, not source-controlled
data/reconciliation/

# ── HM-CLEAN additions (2026-05-12) — working-tree sweep ────────────────────
# HM-G covered backups/, but data/ DB snapshots (.pre-*, .legacy_*) were never
# caught. ~1.06 GB of trader.db pre-op backups currently untracked in data/.
# Mirror the HM-G pattern for the data/ tree.

# Sacred-DB pre-op + legacy snapshots in data/
data/*.db.pre-*
data/*.db.legacy_*
data/*.db-shm.pre-*
data/*.db-wal.pre-*
data/*.db.legacy_*-shm
data/*.db.legacy_*-wal

# Rotating logs
data/model_watch_log.jsonl

# Transient stub + report directories (regenerated/local-only)
archive/stubs/
# Ignore contents of reports/ but not the dir itself, so the whitelist below
# can re-include specific files. Plain `reports/` would block sub-file
# whitelists per git's parent-dir rule.
reports/*
# Exception: banked-items reference docs are tracked (persistent cross-session
# memory of deferred work). Convention added 2026-05-18.
!reports/BANKED_ITEMS_*.md

# Pre-op file-level snapshots in source/backup dirs
shared/*.pre-*
backups/main.py.pre-*

