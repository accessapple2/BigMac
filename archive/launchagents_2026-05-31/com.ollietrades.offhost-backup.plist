<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ollietrades.offhost-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bigmac/autonomous-trader/scripts/offhost_backup.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/bigmac/autonomous-trader</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/bigmac</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bigmac/autonomous-trader/logs/offhost_backup.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/bigmac/autonomous-trader/logs/offhost_backup.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
