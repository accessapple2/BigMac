```

Add a gated branch in `generate_kirk_advisory()` at `dashboard/app.py:13420` (per CLAUDE.md item 24, source routing in `docs/KIRK_SOURCES.md`):

```python
import os
KIRK_FRONTIER_REVIEW = os.getenv("KIRK_FRONTIER_REVIEW", "false").lower() == "true"
KIRK_FRONTIER_MODELS = os.getenv("KIRK_FRONTIER_MODELS", "").split(",")

def _frontier_cross_check(signal, advisory):
    """LOG ONLY — never blocks. Inactive unless KIRK_FRONTIER_REVIEW=true."""
    if not KIRK_FRONTIER_REVIEW:
        return
    if not _is_real_money_signal(signal):
        return
    for model in KIRK_FRONTIER_MODELS:
        if not model.strip():
            continue
        try:
            resp = ollama_client.chat(
                model=model.strip(),
                messages=[{"role": "user", "content": _build_frontier_prompt(signal, advisory)}],
                options={"timeout": 30}
            )
            _log_frontier_response(signal["id"], model, resp)
        except Exception as e:
            logger.warning(f"frontier review {model} failed: {e}")
```

Add tracking column (idempotent):
